# Google Calendar sync (optional). Without these the site shows the sample
# schedule from src/data/events.ts.
# 1. Make the club calendar public (Calendar settings > Access permissions).
# 2. Copy its Calendar ID (Calendar settings > Integrate calendar).
# 3. Create an API key with the "Google Calendar API" enabled in Google Cloud.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# Email signups (optional). Each signup is POSTed here as JSON:
#   { "email": "...", "source": "...", "submittedAt": "ISO date" }
# Works with a Google Apps Script web app, Zapier/Make webhook, Formspree, etc.
SUBSCRIBE_WEBHOOK_URL=

# "Have an idea for a track?" form (optional). Each idea is POSTed here as JSON:
#   { "idea": "...", "email": "... or empty", "submittedAt": "ISO date" }
SUGGEST_WEBHOOK_URL=
